<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brooks.mall.user.mapper.UserMapper">

    <!-- 2. 新增插入语句 (Register用) -->
    <insert id="insertUser" parameterType="com.brooks.mall.user.entity.User">
        INSERT INTO orguser (
        id, created_at, created_by, updated_at, updated_by,
        user_id, user_name, password,
        <!-- 可选字段：同时判断 null 和空字符串 -->
        <if test="email != null and email.trim() != ''">email,</if>
        <if test="mobile != null and mobile.trim() != ''">mobile,</if>
        <if test="realName != null and realName.trim() != ''">real_name,</if>
        <if test="idCard != null and idCard.trim() != ''">id_card,</if>
        <if test="avatar != null and avatar.trim() != ''">avatar,</if>
        status,
        is_deleted
        ) VALUES (
        #{id}, #{createdAt}, #{createdBy}, #{updatedAt}, #{updatedBy},
        #{userId}, #{userName}, #{password},
        <if test="email != null and email.trim() != ''">#{email},</if>
        <if test="mobile != null and mobile.trim() != ''">#{mobile},</if>
        <if test="realName != null and realName.trim() != ''">#{realName},</if>
        <if test="idCard != null and idCard.trim() != ''">#{idCard},</if>
        <if test="avatar != null and avatar.trim() != ''">#{avatar},</if>
        #{status},
        #{isDeleted}
        )
    </insert>
</mapper>